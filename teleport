local dragConnIndex = 0
local function enableDrag(handle, target)
        local dragging = false
        local dragStart, startPos
        local wasDragged = false

        dragConnIndex += 1
        CleanupManager:AddConn("DragBegan" .. dragConnIndex, handle.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        wasDragged = false
                        dragStart = input.Position
                        startPos = target.Position
                end
        end))

        dragConnIndex += 1
        CleanupManager:AddConn("DragEnded" .. dragConnIndex, handle.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                end
        end))

        dragConnIndex += 1
        CleanupManager:AddConn("DragMoved" .. dragConnIndex, UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then
                        local delta = input.Position - dragStart
                        if delta.Magnitude >= 6 then wasDragged = true end
                        target.Position = UDim2.new(
                                startPos.X.Scale, math.floor(startPos.X.Offset + delta.X + 0.5),
                                startPos.Y.Scale, math.floor(startPos.Y.Offset + delta.Y + 0.5)
                        )
                end
        end))
        return function() return wasDragged end
end

