-- 1. CLEANUP MANAGER (Complete Lifecycle)
-- ==========================================
local CleanupManager = {
        Connections = {},
        Instances = {},
        Drawings = {},
        CustomCleanups = {}
}

function CleanupManager:AddConn(name, conn)
        if self.Connections[name] then self.Connections[name]:Disconnect() end
        self.Connections[name] = conn
        return conn
end

-- [v3.8] ถอด connection ออกจากทะเบียน — ใช้กับ conn อายุสั้น (จับ slider) กันทะเบียนบวม
function CleanupManager:RemoveConn(name)
        local conn = self.Connections[name]
        if conn then
                self.Connections[name] = nil
                pcall(conn.Disconnect, conn)
        end
end

function CleanupManager:AddInstance(name, inst)
        if self.Instances[name] then self.Instances[name]:Destroy() end
        self.Instances[name] = inst
        return inst
end

function CleanupManager:AddDrawing(name, drawing)
        if self.Drawings[name] then self.Drawings[name]:Remove() end
        self.Drawings[name] = drawing
        return drawing
end

function CleanupManager:AddCustomCleanup(func)
        table.insert(self.CustomCleanups, func)
end

function CleanupManager:CleanAll()
        getgenv().Glx_Running = false

        -- [v3.1] pcall ทุกรายการ — ของชิ้นเดียวที่เสีย (Drawing ถูกทำลายไปแล้ว ฯลฯ)
        -- เดิมทำให้ CleanAll ตายค้างรายการ = รอบรันใหม่พังตั้งแต่บรรทัดล้างของเก่า
        for _, conn in pairs(self.Connections) do pcall(conn.Disconnect, conn) end
        for _, inst in pairs(self.Instances) do pcall(inst.Destroy, inst) end
        for _, draw in pairs(self.Drawings) do pcall(draw.Remove, draw) end
        for _, func in ipairs(self.CustomCleanups) do pcall(func) end

        table.clear(self.Connections)
        table.clear(self.Instances)
        table.clear(self.Drawings)
        table.clear(self.CustomCleanups)

        -- [v3.9] ปล่อย identity ให้ sweeper loop (กวาด ESP ทุก 5 วิ / TargetStates ทุก 10 วิ)
        -- รู้ว่ารอบนี้ตายแล้ว — เดิม Glx_Cleanup ยังชี้ manager นี้ต่อหลัง unload = loop ตื่นมา
        -- ทำงานเปล่า ๆ ตลอดไปจนกว่าจะรันรอบใหม่ (ทรัพยากรรั่วเงียบ ๆ หลังถอดสคริปต์)
        if getgenv().Glx_Cleanup == CleanupManager then
                getgenv().Glx_Cleanup = nil
        end
end

