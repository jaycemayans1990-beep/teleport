-- language: Luau (Roblox executor script), file: behind_tp.lua, target: Delta mobile
-- Tap TP = teleport behind a random enemy (10 studs, facing their back) · drag box to move · badge = drag-lock

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local StarterGui = game:GetService("StarterGui")

local me = Players.LocalPlayer

local DIST = 10      -- studs behind target
local TAP_SLOP = 8   -- px of finger drift still counted as a tap (not a drag)

local function notify(text)
	pcall(function()
		StarterGui:SetCore("SendNotification", { Title = "BehindTP", Text = text, Duration = 2 })
	end)
end

local function pickEnemy()
	local pool = {}
	for _, plr in Players:GetPlayers() do
		-- same named team = teammate; teamless/FFA games = everyone is an enemy
		if plr ~= me and not (me.Team ~= nil and plr.Team == me.Team) then
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if hum and root and hum.Health > 0 then
				pool[#pool + 1] = root
			end
		end
	end
	if #pool == 0 then return nil end
	return pool[math.random(#pool)]
end

local function teleport()
	local myRoot = me.Character and me.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end
	local target = pickEnemy()
	if not target then notify("ไม่มีศัตรู") return end
	local spot = target.CFrame * CFrame.new(0, 0, DIST) -- local +Z = หลังเป้า
	myRoot.CFrame = CFrame.lookAt(spot.Position, target.Position)
end

-- UI -------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "BehindTP"
gui.ResetOnSpawn = false
gui.Parent = (gethui and gethui()) or CoreGui

local box = Instance.new("Frame")
box.Size = UDim2.fromOffset(44, 44)
box.Position = UDim2.new(0.4, 0, 0.5, 0)
box.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
box.BackgroundTransparency = 0.2
box.BorderSizePixel = 0
box.Active = true
box.Parent = gui
Instance.new("UICorner", box).CornerRadius = UDim.new(0, 10)

local tp = Instance.new("TextButton")
tp.Size = UDim2.fromScale(1, 1)
tp.BackgroundTransparency = 1
tp.Font = Enum.Font.GothamBold
tp.TextSize = 15
tp.TextColor3 = Color3.fromRGB(240, 240, 240)
tp.Text = "TP"
tp.Parent = box

local lockBadge = Instance.new("TextButton")
lockBadge.Size = UDim2.fromOffset(18, 18)
lockBadge.Position = UDim2.new(1, -8, 0, -8)
lockBadge.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
lockBadge.BorderSizePixel = 0
lockBadge.Font = Enum.Font.SourceSans
lockBadge.TextSize = 12
lockBadge.Text = "🔓"
lockBadge.Parent = box
Instance.new("UICorner", lockBadge).CornerRadius = UDim.new(1, 0)

-- drag (whole box) -----------------------------------------------
local locked = false
local dragging = false
local dragStart, startPos

local isPress = function(io)
	return io.UserInputType == Enum.UserInputType.Touch
		or io.UserInputType == Enum.UserInputType.MouseButton1
end

box.InputBegan:Connect(function(io)
	if isPress(io) then
		dragging, dragStart, startPos = true, io.Position, box.Position
	end
end)

box.InputChanged:Connect(function(io)
	if not dragging or locked then return end
	local d = io.Position - dragStart
	box.Position = startPos + UDim2.fromOffset(d.X, d.Y)
end)

box.InputEnded:Connect(function(io)
	if isPress(io) then dragging = false end
end)

-- tap = teleport (release within TAP_SLOP px) ---------------------
local pressPos
tp.InputBegan:Connect(function(io)
	if isPress(io) then pressPos = io.Position end
end)
tp.InputEnded:Connect(function(io)
	if not pressPos then return end
	local tap = (io.Position - pressPos).Magnitude <= TAP_SLOP
	pressPos = nil
	if tap then teleport() end
end)

lockBadge.Activated:Connect(function()
	locked = not locked
	lockBadge.Text = locked and "🔒" or "🔓"
end)

print("[BehindTP] loaded")
