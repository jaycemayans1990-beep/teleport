-- language: Luau (Roblox executor script), file: behind_tp.lua, target: Delta mobile
-- Tap TP = teleport behind a random enemy (10 studs, facing their back) · drag box to move · badge = drag-lock

local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local StarterGui = game:GetService("StarterGui")

local me = Players.LocalPlayer

local DIST = 10      -- studs behind target
local TAP_SLOP = 8   -- px of finger drift still counted as a tap (not a drag)

local function notify(text)
	pcall(function()
		StarterGui:SetCore("SendNotification", { Title = "BehindTP", Text = text, Duration = 2 })
	end)
end

local function pickTarget()
	local cam = workspace.CurrentCamera
	if not cam then return nil end

	-- 1) raycast จากกลางจอ (จุดเล็ง) หาตัวละครตรง ๆ
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { me.Character }
	local hit = workspace:Raycast(cam.CFrame.Position, cam.CFrame.LookVector * 1000, rayParams)
	local model = hit and hit.Instance:FindFirstAncestorOfClass("Model")

	-- 2) ไม่โดนตัวละคร = เอาศัตรูที่อยู่ใกล้จุดเล็งที่สุดบนจอแทน
	if not (model and model:FindFirstChildOfClass("Humanoid")) then
		local vp = cam.ViewportSize / 2
		local best, bestDist
		for _, plr in Players:GetPlayers() do
			if plr ~= me and not (me.Team ~= nil and plr.Team == me.Team) then
				local char = plr.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if hum and root and hum.Health > 0 then
					local sp, on = cam:WorldToViewportPoint(root.Position)
					if on then
						local d = (Vector2.new(sp.X, sp.Y) - vp).Magnitude
						if not bestDist or d < bestDist then
							best, bestDist = root, d
						end
					end
				end
			end
		end
		return best
	end

	-- โดนตัวละครตรง ๆ: เช็คว่าเป็นศัตรู + ยังมีชีวิต
	local plr = Players:GetPlayerFromCharacter(model)
	if plr and plr ~= me and not (me.Team ~= nil and plr.Team == me.Team) then
		local hum = model:FindFirstChildOfClass("Humanoid")
		local root = model:FindFirstChild("HumanoidRootPart")
		if hum and root and hum.Health > 0 then return root end
	end
	return nil
end

local function teleport()
	local myRoot = me.Character and me.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return end
	local target = pickTarget()
	if not target then notify("ไม่พบเป้าหมายบนหน้าจอ") return end
	local spot = target.CFrame * CFrame.new(0, 0, DIST) -- local +Z = หลังเป้า
	-- หันหน้าไปทางเดียวกับศัตรู = เพ่งไปที่หลังหัวศัตรู (ตัด pitch ของเป้าออก กันตัวเอียง)
	local lv = target.CFrame.LookVector
	local face = Vector3.new(lv.X, 0, lv.Z)
	face = face.Magnitude > 0.05 and face.Unit or Vector3.new(0, 0, -1)
	myRoot.CFrame = CFrame.lookAt(spot.Position, spot.Position + face)
end

-- UI -------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "BehindTP"
gui.ResetOnSpawn = false
gui.Parent = (gethui and gethui()) or CoreGui

local box = Instance.new("Frame")
box.Size = UDim2.fromOffset(44, 44)
box.Position = UDim2.new(0.4, 0, 0.5, 0)
box.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
box.BackgroundTransparency = 0.2
box.BorderSizePixel = 0
box.Active = true
box.Parent = gui
Instance.new("UICorner", box).CornerRadius = UDim.new(0, 10)

local tp = Instance.new("TextButton")
tp.Size = UDim2.fromScale(1, 1)
tp.BackgroundTransparency = 1
tp.Font = Enum.Font.GothamBold
tp.TextSize = 15
tp.TextColor3 = Color3.fromRGB(240, 240, 240)
tp.Text = "TP"
tp.Parent = box

local lockBadge = Instance.new("TextButton")
lockBadge.Size = UDim2.fromOffset(18, 18)
lockBadge.Position = UDim2.new(1, -8, 0, -8)
lockBadge.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
lockBadge.BorderSizePixel = 0
lockBadge.Font = Enum.Font.SourceSans
lockBadge.TextSize = 12
lockBadge.Text = "🔓"
lockBadge.Parent = box
Instance.new("UICorner", lockBadge).CornerRadius = UDim.new(1, 0)

-- drag + tap: เริ่มจับที่ tp (ปุ่มกิน touch ก่อน frame ที่อยู่ใต้เสมอ)
-- ขยับ/ปล่อยผ่าน UserInputService → ลากต่อได้แม้นิ้วเลื่อนออกนอกกล่อง
local UIS = game:GetService("UserInputService")

local locked = false
local dragInput, dragStart, startPos

local isPress = function(io)
	return io.UserInputType == Enum.UserInputType.Touch
		or io.UserInputType == Enum.UserInputType.MouseButton1
end

tp.InputBegan:Connect(function(io)
	if isPress(io) then
		dragInput, dragStart, startPos = io, io.Position, box.Position
	end
end)

UIS.InputChanged:Connect(function(io)
	if io ~= dragInput or locked then return end
	local d = io.Position - dragStart
	box.Position = startPos + UDim2.fromOffset(d.X, d.Y)
end)

UIS.InputEnded:Connect(function(io)
	if io ~= dragInput then return end
	dragInput = nil
	-- แตะ (ขยับ ≤ TAP_SLOP) = เทเลพอร์ต · ทำงานแม้ตอนล็อก (ล็อกกั้นแค่การลาก)
	if (io.Position - dragStart).Magnitude <= TAP_SLOP then
		teleport()
	end
end)

lockBadge.Activated:Connect(function()
	locked = not locked
	lockBadge.Text = locked and "🔒" or "🔓"
end)

print("[BehindTP] loaded")
