-- ==========================================
-- 6. TARGET SERVICE (State Machine)
-- ==========================================
local TargetService = {
        CurrentTarget = nil,
        TargetPart = nil,
        LockedPartName = nil
}

local RANDOM_PARTS = { "Head", "UpperTorso", "LowerTorso", "HumanoidRootPart" }

function TargetService:GetTargetPart(char)
        local root = char:FindFirstChild("HumanoidRootPart")
        if State.TargetPartMode == "Head" then
                return char:FindFirstChild("Head") or root
        end
        if State.TargetPartMode == "Random" then
                if self.LockedPartName then
                        local locked = char:FindFirstChild(self.LockedPartName)
                        if locked then return locked end
                end
                local name = RANDOM_PARTS[math.random(1, #RANDOM_PARTS)]
                local picked = char:FindFirstChild(name)
                if not picked then
                        picked = root
                        name = "HumanoidRootPart"
                end
                self.LockedPartName = name
                return picked
        end
        return root
end

function TargetService:ReleaseTarget()
        self.CurrentTarget = nil
        self.TargetPart = nil
        self.LockedPartName = nil
        targetGraceUntil = 0
        keepWallCheckUntil = 0
        keepWallVisible = true
end

function TargetService:KeepTarget(camera, screenX, screenY, scaledFOV)
        local target = self.CurrentTarget
        if not isValidEnemy(target) then return false, false end

        local part = self.TargetPart
        if not (part and part.Parent and part:IsDescendantOf(target.Character)) then
                return false, false
        end

        if State.WallCheck then
                local nowWC = os.clock()
                if nowWC >= (keepWallCheckUntil or 0) then
                        keepWallCheckUntil = nowWC + (1 / 15)
                        keepWallVisible = VisibilityService:CheckVisibility(target.Character, 1, part)
                end
                if not keepWallVisible then return false, false end
        end

        local screenPoint, onScreen = camera:WorldToViewportPoint(part.Position)
        if not onScreen or screenPoint.Z <= 0 then return false, true end

        local dx = screenPoint.X - screenX
        local dy = screenPoint.Y - screenY
        local keepRadius = scaledFOV * KEEP_HYSTERESIS
        return dx*dx + dy*dy <= keepRadius * keepRadius, false
end

function TargetService:AcquireTarget(camera, screenX, screenY, scaledFOV)
        local closestDistSq = scaledFOV * scaledFOV
        local banRadiusSq = (scaledFOV * 0.12) * (scaledFOV * 0.12)
        local closestPlayer, bestPart = nil, nil
        local now = os.clock()
        local cooldownActive = switchCooldownUntil > now and switchAwayKey ~= nil

        local players = Players:GetPlayers()
        for i = 1, #players do
                local player = players[i]
                if isValidEnemy(player) then
                        local part = self:GetTargetPart(player.Character)
                        if part then
                                local screenPoint, onScreen = camera:WorldToViewportPoint(part.Position)
                                if onScreen and screenPoint.Z > 0 then
                                        local dx = screenPoint.X - screenX
                                        local dy = screenPoint.Y - screenY
                                        local distSq = dx*dx + dy*dy
                                        local banned = cooldownActive and player == switchAwayKey
                                        if distSq < closestDistSq and (not banned or distSq <= banRadiusSq) then
                                                if not State.WallCheck
                                                        or VisibilityService:CheckVisibility(player.Character, 1, part) then
                                                        closestDistSq = distSq
                                                        closestPlayer = player
                                                        bestPart = part
                                                end
                                        end
                                end
                        end
                end
        end

        if closestPlayer then
                if closestPlayer ~= self.CurrentTarget then
                        self.LockedPartName = nil
                end
                self.CurrentTarget = closestPlayer
                self.TargetPart = bestPart
        end
end

function TargetService:CheckSwitch(camera, screenX, screenY, scaledFOV)
        local now = os.clock()
        if now - lastSwitchCheck < SWITCH_CHECK_INTERVAL then return end
        lastSwitchCheck = now

        local target = self.CurrentTarget
        local part = self.TargetPart
        if not (target and part and part.Parent) then return end

        local myPoint, myOn = camera:WorldToViewportPoint(part.Position)
        if not (myOn and myPoint.Z > 0) then return end
        local myDx, myDy = myPoint.X - screenX, myPoint.Y - screenY
        local myDistSq = myDx*myDx + myDy*myDy

        local limitSq = math.min(myDistSq * (SWITCH_RATIO * SWITCH_RATIO), scaledFOV * scaledFOV)
        if limitSq <= 0 then return end

        local cooldownActive = switchCooldownUntil > now and switchAwayKey ~= nil
        local banRadiusSq = (scaledFOV * 0.12) * (scaledFOV * 0.12)
        local bestDistSq = limitSq
        local bestPlayer, bestPart = nil, nil

        local players = Players:GetPlayers()
        for i = 1, #players do
                local player = players[i]
                if player ~= target and isValidEnemy(player) then
                        local cand = self:GetTargetPart(player.Character)
                        if cand then
                                local sp, onScreen = camera:WorldToViewportPoint(cand.Position)
                                if onScreen and sp.Z > 0 then
                                        local dx = sp.X - screenX
                                        local dy = sp.Y - screenY
                                        local distSq = dx*dx + dy*dy
                                        local banned = cooldownActive and player == switchAwayKey
                                        if distSq < bestDistSq and (not banned or distSq <= banRadiusSq) then
                                                bestDistSq = distSq
                                                bestPlayer = player
                                                bestPart = cand
                                        end
                                end
                        end
                end
        end

        if bestPlayer and (not State.WallCheck
                or VisibilityService:CheckVisibility(bestPlayer.Character, 1, bestPart)) then
                switchAwayKey = target
                switchCooldownUntil = now + SWITCH_COOLDOWN
                self.CurrentTarget = bestPlayer
                self.TargetPart = bestPart
                self.LockedPartName = nil
                targetGraceUntil = 0
                keepWallCheckUntil = 0
                keepWallVisible = true
        end
end

